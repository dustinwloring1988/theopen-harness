{
  "name": "@buckeyestudio/toh-llm-deepseek",
  "description": "DeepSeek chat-completions adapter for the TheOpen Harness LLM seam",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
