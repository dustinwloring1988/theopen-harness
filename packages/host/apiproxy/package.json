{
  "name": "@buckeyestudio/toh-host-apiproxy",
  "description": "API gateway: the ApiProxy contract (api/), the fetch carrier pair (fetch/), and the host-side gateway plugin providing ctx.apiProxy",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dustinwloring1988/theopen-harness.git",
    "directory": "packages/host/apiproxy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./api": {
      "types": "./lib/types/api/index.d.ts",
      "default": "./lib/types/api/index.js"
    },
    "./api/*": {
      "types": "./lib/types/api/*.d.ts",
      "default": "./lib/types/api/*.js"
    },
    "./client": {
      "types": "./lib/types/fetch/client.d.ts",
      "default": "./lib/types/fetch/client.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "author": "buckeyestudio",
  "dependencies": {
    "@buckeyestudio/toh-attachment": "workspace:^",
    "@buckeyestudio/toh-agent": "workspace:^",
    "@buckeyestudio/toh-agent-default-model": "workspace:^",
    "@buckeyestudio/toh-api-remotes": "workspace:^",
    "@buckeyestudio/toh-brand": "workspace:^",
    "@buckeyestudio/toh-commands": "workspace:^",
    "@buckeyestudio/toh-credentials": "workspace:^",
    "@buckeyestudio/toh-goal": "workspace:^",
    "@buckeyestudio/toh-host-directory-picker": "workspace:^",
    "@buckeyestudio/toh-llm": "workspace:^",
    "@buckeyestudio/toh-native-command": "workspace:^",
    "@buckeyestudio/toh-session": "workspace:^",
    "@buckeyestudio/toh-session-persistence": "workspace:^",
    "@buckeyestudio/toh-session-projection": "workspace:^",
    "@buckeyestudio/toh-session-projection-cache": "workspace:^",
    "@buckeyestudio/toh-session-query": "workspace:^",
    "@buckeyestudio/toh-session-title": "workspace:^",
    "@buckeyestudio/toh-settings": "workspace:^",
    "@buckeyestudio/toh-skill": "workspace:^",
    "@buckeyestudio/toh-subagent": "workspace:^",
    "@buckeyestudio/toh-jobs": "workspace:^",
    "@buckeyestudio/toh-tools": "workspace:^",
    "@buckeyestudio/toh-user-approval": "workspace:^",
    "@buckeyestudio/toh-user-questions": "workspace:^",
    "@buckeyestudio/toh-workspace": "workspace:^",
    "@buckeyestudio/schemastery": "workspace:^",
    "fflate": "^0.8.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@buckeyestudio/cordis": "workspace:^",
    "@buckeyestudio/toh-agent-presets": "workspace:^",
    "@buckeyestudio/toh-cordis-host-runner": "workspace:^",
    "@buckeyestudio/toh-invariants": "workspace:^"
  },
  "devDependencies": {
    "@buckeyestudio/cordis": "workspace:^",
    "@buckeyestudio/toh-agent-presets": "workspace:^",
    "@buckeyestudio/toh-cordis-host-runner": "workspace:^",
    "@buckeyestudio/toh-invariants": "workspace:^",
    "@buckeyestudio/toh-storage": "workspace:^",
    "@buckeyestudio/toh-storage-domain": "workspace:^",
    "@buckeyestudio/toh-typert-protocol": "workspace:^",
    "@buckeyestudio/toh-typert-registry": "workspace:^",
    "@buckeyestudio/cordis": "workspace:^"
  }
}
