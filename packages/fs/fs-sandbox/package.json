{
  "name": "@buckeyestudio/toh-fs-sandbox",
  "description": "Sandbox-enforcing implementation of the TheOpen Harness filesystem seam: fences write/edit by the per-call sandbox mode (read-only denies mutation, workspace-write contains it to the workspace + temp roots) while reads pass through",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dustinwloring1988/theopen-harness.git",
    "directory": "packages/fs/fs-sandbox"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "author": "buckeyestudio",
  "peerDependencies": {
    "@buckeyestudio/toh-fs": "workspace:^",
    "@buckeyestudio/toh-fs-local": "workspace:^",
    "@buckeyestudio/toh-invariants": "workspace:^",
    "@buckeyestudio/toh-sandbox": "workspace:^",
    "@buckeyestudio/toh-sandbox-policy": "workspace:^",
    "@buckeyestudio/cordis": "workspace:^"
  },
  "devDependencies": {
    "@buckeyestudio/toh-fs": "workspace:^",
    "@buckeyestudio/toh-fs-local": "workspace:^",
    "@buckeyestudio/toh-invariants": "workspace:^",
    "@buckeyestudio/toh-sandbox": "workspace:^",
    "@buckeyestudio/toh-sandbox-policy": "workspace:^",
    "@buckeyestudio/cordis": "workspace:^"
  }
}
