{
  "name": "@buckeyestudio/toh-tool-fs",
  "description": "Model-facing filesystem tools (read, write, edit) over the TheOpen Harness filesystem seam (ctx.fs)",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dustinwloring1988/theopen-harness.git",
    "directory": "packages/fs/tool-fs"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "author": "buckeyestudio",
  "dependencies": {
    "diff": "^9.0.0",
    "@buckeyestudio/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@buckeyestudio/toh-attachment": "workspace:^",
    "@buckeyestudio/toh-fs": "workspace:^",
    "@buckeyestudio/toh-invariants": "workspace:^",
    "@buckeyestudio/toh-llm": "workspace:^",
    "@buckeyestudio/toh-sandbox": "workspace:^",
    "@buckeyestudio/toh-sandbox-policy": "workspace:^",
    "@buckeyestudio/toh-session": "workspace:^",
    "@buckeyestudio/toh-system-prompt": "workspace:^",
    "@buckeyestudio/toh-tools": "workspace:^",
    "@buckeyestudio/toh-user-approval": "workspace:^",
    "@buckeyestudio/cordis": "workspace:^"
  },
  "devDependencies": {
    "@buckeyestudio/toh-agent": "workspace:^",
    "@buckeyestudio/toh-agent-loop": "workspace:^",
    "@buckeyestudio/toh-agent-loop-testkit": "workspace:^",
    "@buckeyestudio/toh-attachment": "workspace:^",
    "@buckeyestudio/toh-fs": "workspace:^",
    "@buckeyestudio/toh-fs-local": "workspace:^",
    "@buckeyestudio/toh-fs-observation-policy": "workspace:^",
    "@buckeyestudio/toh-invariants": "workspace:^",
    "@buckeyestudio/toh-llm": "workspace:^",
    "@buckeyestudio/toh-llm-deepseek": "workspace:^",
    "@buckeyestudio/toh-sandbox": "workspace:^",
    "@buckeyestudio/toh-sandbox-policy": "workspace:^",
    "@buckeyestudio/toh-session": "workspace:^",
    "@buckeyestudio/toh-system-prompt": "workspace:^",
    "@buckeyestudio/toh-tools": "workspace:^",
    "@buckeyestudio/toh-user-approval": "workspace:^",
    "@buckeyestudio/cordis": "workspace:^"
  }
}
