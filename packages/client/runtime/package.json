{
  "name": "@buckeyestudio/toh-client-runtime",
  "description": "Client core services: SlotRegistry, SessionRuntime (scope tree + object layer)",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dustinwloring1988/theopen-harness.git",
    "directory": "packages/client/runtime"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "toh": {
    "client": {
      "inject": [
        "@buckeyestudio/toh-client-connection",
        "@buckeyestudio/toh-typert-registry",
        "@buckeyestudio/toh-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "author": "buckeyestudio",
  "dependencies": {
    "immer": "^10.1.1",
    "zustand": "~4.4.7"
  },
  "peerDependencies": {
    "@buckeyestudio/cordis": "workspace:^",
    "@buckeyestudio/toh-api-remotes": "workspace:^",
    "@buckeyestudio/toh-invariants": "workspace:^",
    "@buckeyestudio/toh-typert-protocol": "workspace:^",
    "@buckeyestudio/toh-typert-registry": "workspace:^",
    "@buckeyestudio/toh-agent": "workspace:^",
    "@buckeyestudio/toh-attachment": "workspace:^",
    "@buckeyestudio/toh-client-connection": "workspace:^",
    "@buckeyestudio/toh-commands": "workspace:^",
    "@buckeyestudio/toh-host-apiproxy": "workspace:^",
    "@buckeyestudio/toh-llm": "workspace:^",
    "@buckeyestudio/toh-llm-retry": "workspace:^",
    "@buckeyestudio/toh-session": "workspace:^",
    "@buckeyestudio/toh-session-projection": "workspace:^",
    "@buckeyestudio/toh-session-title": "workspace:^",
    "@buckeyestudio/toh-tools": "workspace:^"
  },
  "devDependencies": {
    "@buckeyestudio/cordis": "workspace:^",
    "@buckeyestudio/toh-api-remotes": "workspace:^",
    "@buckeyestudio/toh-invariants": "workspace:^",
    "@buckeyestudio/toh-timeout": "workspace:^",
    "@buckeyestudio/toh-typert-protocol": "workspace:^",
    "@buckeyestudio/toh-typert-registry": "workspace:^",
    "@types/react": "~19.2.3",
    "@buckeyestudio/toh-client-ui-slots": "workspace:^",
    "react": "^19.2.8",
    "@buckeyestudio/toh-agent": "workspace:^",
    "@buckeyestudio/toh-attachment": "workspace:^",
    "@buckeyestudio/toh-client-connection": "workspace:^",
    "@buckeyestudio/toh-commands": "workspace:^",
    "@buckeyestudio/toh-host-apiproxy": "workspace:^",
    "@buckeyestudio/toh-llm": "workspace:^",
    "@buckeyestudio/toh-llm-retry": "workspace:^",
    "@buckeyestudio/toh-session": "workspace:^",
    "@buckeyestudio/toh-session-projection": "workspace:^",
    "@buckeyestudio/toh-session-title": "workspace:^",
    "@buckeyestudio/toh-tools": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
