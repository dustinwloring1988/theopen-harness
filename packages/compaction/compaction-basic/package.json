{
  "name": "@buckeyestudio/toh-compaction-basic",
  "description": "Token-meter-driven compaction policy and LLM summarization backend for the TheOpen Harness",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dustinwloring1988/theopen-harness.git",
    "directory": "packages/compaction/compaction-basic"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "author": "buckeyestudio",
  "peerDependencies": {
    "@buckeyestudio/toh-agent": "workspace:^",
    "@buckeyestudio/toh-compaction": "workspace:^",
    "@buckeyestudio/toh-commands": "workspace:^",
    "@buckeyestudio/toh-invariants": "workspace:^",
    "@buckeyestudio/toh-llm": "workspace:^",
    "@buckeyestudio/toh-session": "workspace:^",
    "@buckeyestudio/toh-token-meter": "workspace:^",
    "@buckeyestudio/toh-compaction-tool-result-pruner": "workspace:^",
    "@buckeyestudio/cordis": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@buckeyestudio/toh-compaction-tool-result-pruner": {
      "optional": true
    }
  },
  "dependencies": {
    "@buckeyestudio/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@buckeyestudio/cordis-plugin-include": "workspace:^",
    "@buckeyestudio/cordis-plugin-loader": "workspace:^",
    "@buckeyestudio/toh-agent": "workspace:^",
    "@buckeyestudio/toh-agent-loop": "workspace:^",
    "@buckeyestudio/toh-agent-loop-testkit": "workspace:^",
    "@buckeyestudio/toh-compaction": "workspace:^",
    "@buckeyestudio/toh-commands": "workspace:^",
    "@buckeyestudio/toh-invariants": "workspace:^",
    "@buckeyestudio/toh-llm": "workspace:^",
    "@buckeyestudio/toh-llm-retry": "workspace:^",
    "@buckeyestudio/toh-session": "workspace:^",
    "@buckeyestudio/toh-token-meter": "workspace:^",
    "@buckeyestudio/toh-compaction-tool-result-pruner": "workspace:^",
    "@buckeyestudio/toh-tools": "workspace:^",
    "@buckeyestudio/cordis": "workspace:^"
  }
}
