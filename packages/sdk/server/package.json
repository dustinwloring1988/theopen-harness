{
  "name": "@buckeyestudio/toh-sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process TheOpen Harness SDK clients",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dustinwloring1988/theopen-harness.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "author": "buckeyestudio",
  "dependencies": {
    "@buckeyestudio/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@buckeyestudio/toh-agent": "workspace:^",
    "@buckeyestudio/toh-invariants": "workspace:^",
    "@buckeyestudio/toh-llm": "workspace:^",
    "@buckeyestudio/toh-llm-deepseek": "workspace:^",
    "@buckeyestudio/toh-scope": "workspace:^",
    "@buckeyestudio/toh-sdk-protocol": "workspace:^",
    "@buckeyestudio/toh-session": "workspace:^",
    "@buckeyestudio/toh-subagent": "workspace:^",
    "@buckeyestudio/cordis": "workspace:^"
  },
  "devDependencies": {
    "@buckeyestudio/cordis-plugin-loader": "workspace:^",
    "@buckeyestudio/toh-agent": "workspace:^",
    "@buckeyestudio/toh-agent-spine-demo": "workspace:^",
    "@buckeyestudio/toh-invariants": "workspace:^",
    "@buckeyestudio/toh-llm": "workspace:^",
    "@buckeyestudio/toh-llm-deepseek": "workspace:^",
    "@buckeyestudio/toh-scope": "workspace:^",
    "@buckeyestudio/toh-sdk-protocol": "workspace:^",
    "@buckeyestudio/toh-session": "workspace:^",
    "@buckeyestudio/toh-session-persistence-jsonl": "workspace:^",
    "@buckeyestudio/toh-subagent": "workspace:^",
    "@buckeyestudio/cordis": "workspace:^"
  }
}
